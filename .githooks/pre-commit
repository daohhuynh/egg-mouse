#!/bin/sh
# Refuse any commit that stages a planted mutation-test marker.
#
# WHY THIS EXISTS. Twice on 2026-09-06 a `// MUTANT` reached a commit -- once
# into the FLASH WRITE PHASE, an unbounded A1 09 retry in the one path engineering-rules.md
# §4.2 says must never spin without reporting an unrecoverable state. Both times
# the cause was `git add -A` while `Tests/mutants.sh` was running: it plants a
# mutant, builds, tests, restores, and anything staged mid-cycle catches one.
#
# working-memory.md had already recorded the hazard in prose, twice, and prose
# did not prevent the second one. engineering-rules.md §6.2's rule applies to the committer
# as much as to a reader: when the actor is unreliable, make the property
# decidable without trusting it. Hence a hook rather than another reminder.
#
# ctest's `tree_clean` runs the same check, but only when someone runs ctest --
# which is after the commit. This runs before, which is the point.
#
# Enable (once per clone):  git config core.hooksPath .githooks
staged=$(git diff --cached --name-only --diff-filter=ACM -- 'Sources/*' 'Tests/*.cpp' 'Tests/*.swift')
[ -z "$staged" ] && exit 0

hits=$(git diff --cached -U0 -- $staged | grep -n '^+.*// MUTANT')
if [ -n "$hits" ]; then
    echo "REFUSED: this commit stages a planted mutant."
    echo
    echo "$hits"
    echo
    echo "Tests/mutants.sh is probably running. Check:  pgrep -f mutants.sh"
    echo "  If it IS running   -- WAIT. Its EXIT trap restores every file."
    echo "  If it is NOT       -- restore ONLY the listed files from the last"
    echo "                        clean commit, e.g."
    echo "                          git checkout <clean-rev> -- <file>"
    echo
    echo "NEVER 'git checkout -- Sources/': mutants.sh backs up to a mktemp dir"
    echo "that dies with it, so a blanket revert also destroys uncommitted work."
    exit 1
fi
exit 0
